# Local development and optional bundle variable overrides.
# Copy to .env; never commit the copied file.
DATABRICKS_CONFIG_PROFILE=dbai-dev-admin
DATABRICKS_SQL_WAREHOUSE_ID=<serverless-sql-warehouse-id>
DBAI_CATALOG=<catalog-name>
DBAI_APP_USER=<databricks-username>
MODEL_ENDPOINT=databricks-llama-4-maverick

# The Databricks bundle CLI reads these when no --var values are supplied.
DATABRICKS_BUNDLE_VAR_sql_warehouse_id=<serverless-sql-warehouse-id>
DATABRICKS_BUNDLE_VAR_model_endpoint=databricks-llama-4-maverick

MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc